# ingest-outlook environment configuration
# -----------------------------------------------------------------------------
# Copy these lines into ~/.zshrc (or ~/.bashrc) and fill in the values, or
# `source` this file in your shell session for one-off use.
#
# Get the values from your Azure app registration at
#   https://portal.azure.com → Microsoft Entra ID → App registrations → <your app>

# Application (client) ID — required.
# Personal use: register the app under your personal Microsoft account.
# Corporate use: obtain from your IT admin after the app is registered in the tenant.
export MS_GRAPH_CLIENT_ID="<application-client-id-guid>"

# Directory (tenant) ID — optional, defaults to "common".
#   "common"        → both personal and work/school accounts (recommended for personal use)
#   "consumers"     → personal Microsoft accounts only
#   "<tenant-uuid>" → single-tenant corporate (required for Teams meetings + transcripts)
# export MS_GRAPH_TENANT_ID="common"

# Scopes (space-separated) — optional. Auto-defaults are sensible:
#   personal tenant ("common" or "consumers")  → mail + calendar
#   corporate tenant (any other value)         → mail + calendar + Teams meetings + transcripts
# Override only if you want a different scope set than the default for your tenant.
# export MS_GRAPH_SCOPES="User.Read Mail.Read Calendars.Read OnlineMeetings.Read OnlineMeetingTranscript.Read.All offline_access"

# OAuth loopback port — optional, defaults to 8765.
# Must match the redirect URI registered in Azure (http://localhost:<PORT>/callback).
# Only change if port 8765 is in use on this machine.
# export INGEST_OUTLOOK_REDIRECT_PORT="8765"
