# ingest-outlook environment configuration
# -----------------------------------------------------------------------------
# Copy these lines into ~/.zshrc (or ~/.bashrc) and fill in the values, or
# `source` this file in your shell session for one-off use.
#
# Get the values from your Azure app registration at
#   https://portal.azure.com → Microsoft Entra ID → App registrations → <your app>

# Application (client) ID — required.
# Personal use: register the app under your personal Microsoft account.
# Corporate use: obtain from your IT admin after the app is registered in the tenant.
export MS_GRAPH_CLIENT_ID="<application-client-id-guid>"

# Directory (tenant) ID — optional, defaults to "common".
#   "common"        → both personal and work/school accounts (recommended for personal use)
#   "consumers"     → personal Microsoft accounts only
#   "<tenant-uuid>" → single-tenant corporate (required for Teams meetings + transcripts)
# export MS_GRAPH_TENANT_ID="common"

# Scopes (space-separated) — optional and highest precedence.
# With INGEST_OUTLOOK_READ_ONLY=true, the default is only:
#   User.Read Mail.Read Calendars.Read offline_access
# Without read-only, the legacy personal/corporate scope defaults remain unchanged.
# Override only if you intentionally need a different scope set.
# export MS_GRAPH_SCOPES="User.Read Mail.Read Calendars.Read OnlineMeetings.Read OnlineMeetingTranscript.Read.All offline_access"

# OAuth loopback port — optional, defaults to 8765.
# Must match the redirect URI registered in Azure (http://localhost:<PORT>/callback).
# Only change if port 8765 is in use on this machine.
# export INGEST_OUTLOOK_REDIRECT_PORT="8765"

# Read-only profile — recommended for corporate tenants.
# Blocks send-mail and event create/update/delete before any token or network call.
# export INGEST_OUTLOOK_READ_ONLY="true"

# Default vault root. When set, --vault-root is optional on fetch/doctor/fix.
# Windows PowerShell example: $env:INGEST_OUTLOOK_VAULT_ROOT="$env:USERPROFILE\cerebros\mi-cargo"
# export INGEST_OUTLOOK_VAULT_ROOT="$HOME/second-brain"

# Relative output prefix inside the vault. Absolute paths and ".." are rejected.
# export INGEST_OUTLOOK_OUTPUT_DIR="External Inputs/Outlook"

# Profile (v0.6): one per Microsoft 365 tenant. Same as passing --profile <slug>.
# Its files live in <state directory>/<slug>/.
# export INGEST_OUTLOOK_PROFILE="acme"

# Override state directory (config.json, token.json, logs and refresh lock).
# Primarily useful for isolated tests and portable installations.
# export INGEST_OUTLOOK_CONFIG_DIR="$HOME/.config/ingest-outlook"

# Test-only endpoint overrides. Do not set these for normal Microsoft Graph use.
# export INGEST_OUTLOOK_GRAPH_BASE="http://127.0.0.1:9000"
# export INGEST_OUTLOOK_AUTHORITY_BASE="http://127.0.0.1:9000"

# Advanced (tests): sync time budget in seconds (default 480) and vault-lock timings.
# export INGEST_OUTLOOK_SYNC_BUDGET_SECONDS="480"
# export CEREBRO_LOCK_WAIT_SECONDS="300"
# export CEREBRO_LOCK_STALE_SECONDS="1200"
